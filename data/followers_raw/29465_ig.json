yOTEsImFzc2V0X2FnZV9kYXlzIjoxLCJ2aV91c2VjYXNlX2lkIjoxMDA5OSwiZHVyYXRpb25fcyI6NzAsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=8bb135deeff2f4ee&_nc__U7IHkhgEVAigCQzMsF0BRhR64UeuFGBJkYXNoX2Jhc2VsaW5lXzFfdjERAHX-B2XmnQEA&_nc_gid=bTNQEM2noLsxljxq96y9eQ&_nc_ss=7a22e&_nc_zt=28&oh=00_AQBWqhBOvizZ5h0gr73BqZRFemiGfS80xK7ObDD1yilzKw&oe=6A551066","is_pinned":false},{"caption":"אני גאה ונרגש לקבל את התמיכה של זמן קיבוץ במועמדות שלי לכנסת.\n\nמתוך 51 מועמדות ומועמדים בפריימריז של הדמוקרטים, רק שניים מתגוררים בקיבוצים: חברי, רם שפע ואני. אני גאה להתמודד כדי להביא לכנסת את הקול של הקיבוצים, של העוטף ושל ההתיישבות העובדת.\n\nאני חי בקיבוץ נירים שבעוטף עזה. כאן הבית שלי, כאן עברתי את השבעה באוקטובר, ומכאן נובעת המחויבות העמוקה שלי לשיקום העוטף, לחיזוק יישובי הגבול ולהבטחת עתיד של ביטחון, צמיחה ושגשוג לקיבוצים בכל רחבי הארץ.\n\nהתנועה הקיבוצית מהווה כ־2% בלבד מהחברה הישראלית, אבל התרומה שלה למדינת ישראל גדולה לאין שיעור מחלקה באוכלוסייה. כך היה בהקמת המדינה ובבניינה, וכך גם היה בשנים האחרונות: במאבק נגד ההפיכה המשטרית, במאבק להשבת החטופים ולסיום המלחמה, ובהגנה על דמותה הדמוקרטית והערכית של ישראל.\n\nאני מאמין שלתנועה הקיבוצית יש תפקיד מרכזי בתיקון ובבניית ישראל שאחרי השבעה באוקטובר: בחיזוק הקיבוצים ויישובי הגבול, בשיקום העוטף והצפון, ובבניית ברית חברתית ופוליטית עמוקה בין הקיבוצים, ערי הפיתוח והפריפריות.\n\nזו המחויבות שלי: להבטיח שהתנועה הקיבוצית תמשיך להיות כוח מוביל בחברה הישראלית ולפעול למען הביטחון, השגשוג והעתיד של הקיבוצים בכל רחבי הארץ.\n\nתודה לזמן קיבוץ על התמיכה והאמון. עכשיו ממשיכים בכל הכוח – מהעוטף לכנסת.","datetime":"2026-07-09T17:25:34.000Z","id":"3937592549264453305","image_url":"https://scontent-phl2-1.cdninstagram.com/v/t51.82787-15/742309051_18603303751033275_5584662215775228232_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-phl2-1.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gHg5P9CJssK5-0D_AlzfHOBnStcg7PPvSfJn_wmFjXzw-S0Z3Uqn7JyVZkjAOLUGUY&_nc_ohc=0rm5ZnM5dYcQ7kNvwGmW1gJ&_nc_gid=bTNQEM2noLsxljxq96y9eQ&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQAdhE47y0TBjVamCj2xDCwhhntsoYS7zIILvm0-ukdJ2Q&oe=6A590E24&_nc_sid=8b3546","likes":7,"content_type":"Image","url":"https://www.instagram.com/p/DalI4-xIe65","is_pinned":false},{"caption":"אני מודה לשר לשעבר וחבר הכנסת רן כהן על התמיכה בי ועל הקריאה להצביע לי בפריימריז של הדמוקרטים.\n\nרן הוא מעמודי התווך של השמאל הישראלי ומייצג עבורי את מרצ במיטבה: שמאל ערכי, חברתי, נחוש ולא מתנצל.\n\nהתמיכה שלו והאמירה שאני מהמועמדים הקרובים ביותר לדרכו האידאולוגית מרגשות אותי במיוחד. גאה להמשיך בדרך הזאת ולפעול כדי להביא את הקול הזה לכנסת.","comments":2,"datetime":"2026-07-09T13:48:53.000Z","id":"3937485621322546767","image_url":"https://scontent-phl2-1.cdninstagram.com/v/t51.82787-15/736045134_18603247909033275_7721636831607889591_n.jpg?stp=dst-jpg_e15_tt6&_nc_ht=scontent-phl2-1.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gHg5P9CJssK5-0D_AlzfHOBnStcg7PPvSfJn_wmFjXzw-S0Z3Uqn7JyVZkjAOLUGUY&_nc_ohc=nYrwiTr6EjQQ7kNvwFDxPB1&_nc_gid=bTNQEM2noLsxljxq96y9eQ&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQAGHC8VEw6n5ZUhU0-S7sjxuGZBmJyb2wOyHNr6JR6wCw&oe=6A5920B3&_nc_sid=8b3546","likes":22,"content_type":"Video","url":"https://www.instagram.com/p/Dakwk-XI35P","video_url":"https://scontent-phl2-1.cdninstagram.com/o1/v/t2/f2/m86/AQPQvx1PwTS5evsdmqAc_QGCa9yz-beOSh69jvvLzDtQyBGxIeFui3xmigSNwP_rmNCclbWxksKlygfnK8ZK8c8JlzVXoQn_HELv9Wc.mp4?_nc_cat=108&_nc_sid=5e9851&_nc_ht=scontent-phl2-1.cdninstagram.com&_nc_ohc=_kkw53Cs9yQQ7kNvwHuDgJB&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTY4MjE5NjA0OTc0NTg5MCwiYXNzZXRfYWdlX2RheXMiOjIsInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjo2MiwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=f3c9b9f4b18219b9&_nc_-af2fz8BRUCKAJDMywXQE9RBiTdLxsYEmRhc2hfYmFzZWxpbmVfMV92MREAdf4HZeadAQA&_nc_gid=bTNQEM2noLsxljxq96y9eQ&_nc_ss=7a22e&_nc_zt=28&oh=00_AQB-A3cKurd10vUKhQ4WY1iw52F7BN5pJdnO2tsR6S2rrA&oe=6A553309","is_pinned":false},{"caption":"יש סדק משמעותי מאוד בימין, ואנחנו רואים אותו גם בסקרים וגם בשטח. רק לאחרונה פורסם סקר שהראה שכ־42% ממצביעי הליכוד בבחירות האחרונות לא מתכוונים להצביע שוב לליכוד. משמעות הנתונים האלה ברורה: שינוי פוליטי בישראל הוא אפשרי.\n\nבמטה הפריפריות אנחנו פוגשים את השינוי הזה בכל רחבי הארץ. יותר ויותר אנשים מבינים שהגיע הזמן לפוליטיקה אחרת. פוליטיקה שרואה את הפריפריות, שנאבקת למען שוויון וצדק חברתי, ושמחברת בין שינוי חברתי לשינוי פוליטי עמוק במדינת ישראל.\n\nאת מטה הפריפריות הקמנו חברתי, חברת הכנסת נעמה לזימי, ואני, מתוך מטרה ברורה: להפוך את הפריפריות לכוח חברתי־פוליטי משמעותי ולהביא אותן למרכז קבלת ההחלטות בישראל.\n\nהערב, במסגרת העבודה שלנו במטה הפריפריות, נעמה ואני נגיע לכרמיאל. נמשיך לפגוש את הציבור, לחבר עוד ועוד אנשים לדרך שלנו, להרחיב את המחנה ולבנות את הכוח הפוליטי שיוביל את השינוי החברתי והפוליטי שישראל זקוקה לו.","comments":2,"datetime":"2026-07-09T09:56:54.000Z","id":"3937368145511169796","image_url":"https://scontent-phl2-1.cdninstagram.com/v/t51.82787-15/742832102_18603202123033275_4519750843530750534_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-phl2-1.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gHg5P9CJssK5-0D_AlzfHOBnStcg7PPvSfJn_wmFjXzw-S0Z3Uqn7JyVZkjAOLUGUY&_nc_ohc=k50G2nU21A8Q7kNvwFAS_5f&_nc_gid=bTNQEM2noLsxljxq96y9eQ&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQDuxVcH0lsxhXChI1rbVP0thKQySayU7LnyFEnf_1sA4A&oe=6A593634&_nc_sid=8b3546","likes":53,"content_type":"Video","url":"https://www.instagram.com/p/DakV3efIb8E","video_url":"https://scontent-phl2-1.cdninstagram.com/o1/v/t2/f2/m86/AQO3PoOkCb9u4KJJ5nuXPuWWxIpIueizmHwBIoJ5_rOuYBw-6oayte54okqmWyu0mHapCNu1wtn29Y23gHAjtVLWCPnrAwS0Hbb-K64.mp4?_nc_cat=105&_nc_sid=5e9851&_nc_ht=scontent-phl2-1.cdninstagram.com&_nc_ohc=vGmeDXZZ9lIQ7kNvwG5xl5x&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTQ5Nzc0NzczMTY1NTc0NCwiYXNzZXRfYWdlX2RheXMiOjIsInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjo0NCwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=53cc7698f8119f67&_nc_&_nc_gid=bTNQEM2noLsxljxq96y9eQ&_nc_ss=7a22e&_nc_zt=28&oh=00_AQA09oECR91GEQbWregU1PSxXNQUlgCz