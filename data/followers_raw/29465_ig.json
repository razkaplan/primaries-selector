[{"account":"dabushavi","fbid":"17841400998230377","id":"664161274","followers":1534,"posts_count":950,"is_business_account":false,"is_professional_account":true,"is_verified":false,"avg_engagement":0.0488,"external_url":["https://tinyurl.com/AVIWHATSAPP","https://shorturl.at/bIBGD","https://www.avidabush.com/blank"],"following":480,"posts":[{"caption":"שמעתי בתקשורת שוועדת הבחירות המרכזית של מפלגת הדמוקרטים החליטה לפסול את התמודדתי במסגרת הבטחת הייצוג של מרצ. למי שתהה – אני חבר מרצ מזה 12 שנים. תמכתי באיחוד שלה והקמת מפלגת הדמוקרטים, וכיום אני חבר ועידת הדמוקרטים ומועמד בבחירות המקדימות שלה.\n\nלא במקרה אני שם. אני מקדיש את חיי למחנה הדמוקרטי, למאבק למען שוויון, צדק חברתי, זכויות אדם ודמוקרטיה. גם בחברה האזרחית, גם במחאה וגם בפוליטיקה.\n\nלצערי, מדובר בהחלטה מטופשת, שמשנה את כללי המשחק באמצע המרוץ ונועדה להחליש את הסיכוי שלי להגיע לכנסת. אני לא אקבל אותה ומתכוון לעתור כנגדה באופן מיידי.\n\nההחלטה הזו מחלישה את השותפות החשובה בין מרצ לעבודה והופכת את הבטחת הייצוג לחלולה. מי שעלול להנות ממנה לא יהיו מי שהובילו את מרצ וייצגו אותה בציבוריות הישראלית מזה שנים, בעקביות ובאומץ. זה לא יקרה. \n\nמי שיקבעו את רשימת הדמוקרטים לכנסת הם רק 85 אלף המתפקדות והמתפקדים המדהימים שלנו – שמביעים בי, יום אחר יום, תמיכה חוצת מחנות. אני סומך על שיקול הדעת שלהם, ומקווה שההחלטה תתהפך בקרוב.\n\nהמחויבות שלי לא תזוז במילימטר. אמשיך לפעול כדי לייצג בכנסת את העוטף, את הפריפריה, את המחאה ואת הערכים שאני מאמין בהם. אני בטוח שכך יהיה, ואני בטוח שאהיה בכנסת הבאה.","comments":1,"datetime":"2026-06-30T14:52:25.000Z","id":"3930994469198971416","image_url":"https://scontent-phl2-1.cdninstagram.com/v/t51.82787-15/733171630_18600540286033275_7463788059512483109_n.jpg?stp=dst-jpg_e35_s1080x1080_sh2.08_tt6&_nc_ht=scontent-phl2-1.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gHg5P9CJssK5-0D_AlzfHOBnStcg7PPvSfJn_wmFjXzw-S0Z3Uqn7JyVZkjAOLUGUY&_nc_ohc=CwtkXqGj8_4Q7kNvwGEcYlt&_nc_gid=bTNQEM2noLsxljxq96y9eQ&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQAWPLsANW8Db6L2hsvOwkyUtY_OXWqanmn8kb8RweiRNQ&oe=6A5908D5&_nc_sid=8b3546","likes":30,"content_type":"Image","url":"https://www.instagram.com/p/DaNsqR2oUIY","is_pinned":true},{"caption":"אנחנו מרגישים את זה בכל מקום: הציבור רוצה שינוי, רוצה להחליף את השלטון בישראל. הערב היינו בטבעון, למפגש חשוב ומרגש. תודה למאות המשתתפות והמשתתפים שהגיעו, שאלו והביעו תמיכה בדרך שלנו.\n\nתודה ליו״ר המפלגה, האלוף במיל׳ יאיר גולן, ולחה״כ וראש הסיעה אפרת רייטן על התמיכה והשותפות.\n\nנמשיך לחרוש את הארץ עד למהפך הפוליטי המובטח. \n\nקישור להצטרפות לקבוצת הוואטסאפ שלי בביו באינסטגרם או בתגובה הראשונה בפייסבוק.","comments":1,"datetime":"2026-05-06T20:15:09.000Z","id":"3891291837642077893","image_url":"https://scontent-phl2-1.cdninstagram.com/v/t51.82787-15/691218757_18584103604033275_5968958485454508185_n.jpg?stp=dst-jpg_e35_s1080x1080_sh2.08_tt6&_nc_ht=scontent-phl2-1.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gHg5P9CJssK5-0D_AlzfHOBnStcg7PPvSfJn_wmFjXzw-S0Z3Uqn7JyVZkjAOLUGUY&_nc_ohc=SEj6Tog4mZAQ7kNvwEoMWsF&_nc_gid=bTNQEM2noLsxljxq96y9eQ&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQDX0lBO9F_YrwbJryLZPph_-dckuukVhNP6FMFNLSMNnA&oe=6A591743&_nc_sid=8b3546","likes":5,"content_type":"Image","url":"https://www.instagram.com/p/DYApU80CHbF","is_pinned":true},{"caption":"אלף ימים לטבח. אלף ימים מאז אותו בוקר נורא. אלף ימים, יותר מ־2,200 הרוגים ו־251 חטופים. אלף ימים של הפקרה, של שקרים, של פילוג ושל הסתה – הכול כדי לברוח מאחריות. אלה הדברים שאמרתי הבוקר בבלפור.","comments":36,"datetime":"2026-07-02T07:29:47.000Z","id":"3932221079998920422","image_url":"https://scontent-phl2-1.cdninstagram.com/v/t51.82787-15/730222865_18601055716033275_7096465503973005774_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-phl2-1.cdninstagram.com&_nc_cat=103&_nc_oc=Q6cZ2gHg5P9CJssK5-0D_AlzfHOBnStcg7PPvSfJn_wmFjXzw-S0Z3Uqn7JyVZkjAOLUGUY&_nc_ohc=Uva_0wKysAEQ7kNvwHi1lJH&_nc_gid=bTNQEM2noLsxljxq96y9eQ&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQA3maIjsj7WircDxyJ2S9ygnsCgOgi65f-5SAKUHgOGPw&oe=6A591EBD&_nc_sid=8b3546","likes":217,"content_type":"Video","url":"https://www.instagram.com/p/DaSDj0Lo3bm","video_url":"http