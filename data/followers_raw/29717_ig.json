[{"account":"alidemocrats","fbid":"17841423647462935","id":"23703484248","followers":87,"posts_count":21,"is_business_account":false,"is_professional_account":false,"is_verified":false,"avg_engagement":0.1599,"external_url":["https://did.li/alidemocrats"],"biography":"אבא | איש חינוך | ח”כ לשעבר\nמאמין בשוויון, דמוקרטיה וצדק\nמתמודד בפריימריז הדמוקרטים 💙","following":25,"posts":[{"caption":"לפעמים פוליטיקאים נוטים לפזר הבטחות, אבל כשאני מביט לאחור על הכהונה שלי בכנסת ה-24 - אני מציג קבלות. באתי לעבוד בשבילכם, ולא עצרתי לרגע.\nאני גאה להציג עשייה אמיתית ששינתה את חייהם של אלפי אזרחים, במיוחד בפריפריה: הובלתי מהלך להגדלת הסבסוד לצהרונים באשכולות 4-5 שחסך אלפי שקלים בשנה לכל משפחה, קידמתי הקמת אזורי תעסוקה בפריפריה, ופעלתי למען דור העתיד באמצעות הקמת קרן מלגות לסטודנטים ותוכנית ראשונה מסוגה לאיכות הסביבה. \nהובלתי מהפכה של ממש בתחום הבריאות בצפון, בהבאת מכשור רפואי מתקדם לבתי החולים. לצד זאת, ניהלתי מאבק עיקש שהוביל להצלת חיים של ממש עם הכנסתה לסל התרופות של תרופה נדירה עבור ילדים הסובלים מהיפראוקסלוריה, ופעלתי לחיזוק שירותי החירום בשטח באמצעות פתיחת תחנת מד”א אזורית. \nאת כל העשייה הזו גיביתי בחקיקה חברתית אמיצה שכללה והגשת מעל ל-48 הצעות חוק, הובלתי את השדולה הראשונה בכנסת לקידום ושוויון ותמיכה פומבית ובלתי מתפשרת בהעלאת שכר המינימום ל-40 שקלים. \nבאתי לעבוד בשבילכם, והקבלות האלו הן רק ההתחלה. לא באתי להעביר את הזמן - באתי לשנות מציאות. כדי שאוכל להמשיך את המהפכה הזו, ולמען שותפות יהודית ערבית מנצחת - אני צריך אתכם איתי!","datetime":"2026-07-09T18:02:18.000Z","id":"3937613004349584662","image_url":"https://scontent-dfw6-2.cdninstagram.com/v/t51.82787-15/741284938_18114885448788249_3547726045030611410_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gFntpc1qmOBRMONlLWQtB9C4kQvqdcBBY8FTjAICzlY2XDtdyOnLkiyi3bovHaWKJA&_nc_ohc=2tHJAmX7GvIQ7kNvwEW0XaU&_nc_gid=JteQxclmJ0qADs0nPG7kSw&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQD4OHkgCAiJBSqNG85YI7mKfKL1_jHofKrR19_JkTLWeA&oe=6A5905B0&_nc_sid=8b3546","likes":13,"content_type":"Vi