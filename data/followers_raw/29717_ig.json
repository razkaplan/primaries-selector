nstagram.com/v/t51.82787-15/735259833_18113869123788249_4689378071326805271_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gFntpc1qmOBRMONlLWQtB9C4kQvqdcBBY8FTjAICzlY2XDtdyOnLkiyi3bovHaWKJA&_nc_ohc=sOvWjpirYOoQ7kNvwHMRQ8P&_nc_gid=JteQxclmJ0qADs0nPG7kSw&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQB0jFGCVu0sH3QSdc9yoQ0d6lDyTnpb42p3TIc4WRovDA&oe=6A59225C&_nc_sid=8b3546","likes":17,"content_type":"Video","url":"https://www.instagram.com/p/DaX-OsgMzMu","video_url":"https://scontent-dfw6-1.cdninstagram.com/o1/v/t2/f2/m86/AQOJgPr5Lv-YBLV9yyJWZeKpoeL3uWC6qOf_afP6mr_8Xvre6aLMqO6ZNryraPhTBcEIZTh0QjRCYaL2sqANPJXIfXINKt8HwH1IWTc.mp4?_nc_cat=101&_nc_sid=5e9851&_nc_ht=scontent-dfw6-1.cdninstagram.com&_nc_ohc=fhsGJzpHOD0Q7kNvwHkUvx5&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MjkxMzE5MDkwNTc0NjQzMywiYXNzZXRfYWdlX2RheXMiOjcsInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjo5MywidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=74190eed58dede2f&_nc_-KsChUCKAJDMywXQFdXbItDlYEYEmRhc2hfYmFzZWxpbmVfMV92MREAdf4HZeadAQA&_nc_gid=JteQxclmJ0qADs0nPG7kSw&_nc_ss=7a22e&_nc_zt=28&oh=00_AQBeZRDzmN_Lfs46u_1T0AgJs7F0PxOE6-F3sLry5Plk0g&oe=6A5538B6","is_pinned":false},{"caption":"“בולדוזר של עשייה”. תודה לחברי, ח”כ גלעד קריב, על המילים החמות והתמיכה המרגשת. \nבכנסת ה-24 עבדנו שכם אל שכם. גלעד ואני ישבנו שעות ארוכות, נלחמנו יחד למען שוויון ושותפות יהודית ערבית, והובלנו את המאבקים לביטול חוק הלאום המפלה והקפאת חוק קמיניץ. \nהשותפות בינינו היא ההוכחה שאפשר לעשות פוליטיקה אחרת - אמיצה, ערכית, ולא מתפשרת, המציגה שותפות יהודית ערבית מנצחת. כשאחזור לכנסת הבאה, אני מתכוון להמשיך בדיוק מהנקודה שבה הפסקנו: לתקן, לבנות מחדש ולהבטיח שוויון אזרחי אמיתי לכולם. \nגלעד ידידי, תודה ובהצלחה. מאחל לנו 4 שנים מלאות וטובות של שיקום ועבודה משותפת למען הציבור הישראלי.","comments":1,"datetime":"2026-07-03T17:47:14.000Z","id":"3933231180709662036","image_url":"https://scontent-dfw6-2.cdninstagram.com/v/t51.82787-15/732763229_18113710828788249_151582303342292752_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gFntpc1qmOBRMONlLWQtB9C4kQvqdcBBY8FTjAICzlY2XDtdyOnLkiyi3bovHaWKJA&_nc_ohc=94YfWrTAJaYQ7kNvwH3tXMS&_nc_gid=JteQxclmJ0qADs0nPG7kSw&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQAs3hfHk4aT52b-EzEoJcsX-F0O_KpTYriHkz-Dtz8NuQ&oe=6A5909E1&_nc_sid=8b3546","likes":27,"content_type":"Video","url":"https://www.instagram.com/p/DaVpOtxsI1U","video_url":"https://scontent-dfw6-2.cdninstagram.com/o1/v/t2/f2/m86/AQOrDyTqI8-m4Bzldwy6PtJoVxx-bTir8QSb75WpBEgjTYxyYerpP6RVAXOrPxcxTqN2ZpIYdshV7sOKLUPadu-WtMyestXDOQu-ne0.mp4?_nc_cat=110&_nc_sid=5e9851&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_ohc=np57cOTWC2EQ7kNvwHBsyp2&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTU0OTEwMTAwNjY4MTE1MywiYXNzZXRfYWdlX2RheXMiOjgsInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjoxMDMsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=27baf87a1e834c1a&_nc_&_nc_gid=JteQxclmJ0qADs0nPG7kSw&_nc_ss=7a22e&_nc_zt=28&oh=00_AQCKsXZoVK-05eEteZCGN-gocSwE-4X82g8cAV6eKJ7KZw&oe=6A5537CB","is_pinned":false},{"caption":"אני מגנה את האלימות המזעזעת שהופנתה היום נגד פעילות ופעילי מפלגת הדמוקרטים בשוק התקווה.\nאי אפשר לנתק את האירוע הזה מהאווירה הציבורית שנבנתה כאן בשנים האחרונות. כשהממשלה וחלק מנבחרי הציבור מלבים שוב ושוב הסתה, מסמנים יריבים פוליטיים כאויבים ומעודדים שיח של שנאה ופילוג האלימות בסוף מחלחלת ומגיעה אל הרחוב.\nאני מחזק את כל מי שהותקפו היום וקורא למשטרת ישראל לפעול במהירות, לאתר את התוקפים ולמצות איתם את הדין.\nמי שמפיץ הסתה ומטפח שנאה לא יכול להתנער מהאחריות כשהאלימות מגיעה לרחוב.\nאבל אנחנו לא נירתע. לא נפסיק לפעול למען ישראל דמוקרטית, שוויונית ומשותפת. \nאנחנו נכריע אותם בקלפי, לא באלימות!","comments":2,"datetime":"2026-07-03T11:22:44.000Z","id":"3933063513826730766","image_url":"https://scontent-dfw6-2.cdninstagram.com/v/t51.82787-15/732637425_18113647603788249_4401347266325533767_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gFntpc1qmOBRMONlLWQtB9C4kQvqdcBBY8FTjAICzlY2XDtdyOnLkiyi3bovHaWKJA&_nc_ohc=pTH0F-cC_nIQ7kNvwGNMrBS&_nc_gid=JteQxclmJ0qADs0nPG7kSw&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQD7dtkqADdypf4D_IP8_J_ai0xXFM2rDuqcTt0hXvrvEw&oe=6A5938D7&_nc_sid=8b3546","likes":10,"content_type":"Video","url":"https://www.instagram.com/p/DaVDG10sSMO","video_url":"https://scontent-dfw5-2.cdninstagram.com/o1/v/t2/f2/m86/AQOtI8K8TQSAqSB_vfbQiFapLawv3LIF709VLci4WlvKzqxG4nn6ToifDbrBhYnpQvO8ruWJDZ2qoo_b2fOvItwYraV1Qpth9daJrCo.mp4?_nc_cat=104&_nc_sid=5e9851&_nc_ht=scontent-dfw5-2.cdninstagram.com&_nc_ohc=Ut55n5KAo8MQ7kNvwH_LloA&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNTc2LmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTAyMjE0NjExMzUwNzIwMCwiYXNzZXRfYWdlX2RheXMiOjgsInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjoxOCwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=bdbdeec74eb9c4ee&_nc_&_nc_gid=JteQxclmJ0qADs0nPG7kSw&_nc_ss=7a22e&_nc_zt=28&oh=00_AQDxQtNrwe7a0YtZA3K3Vi2hgn8HcFAicrn42kbQBJcKhA&oe=6A5511BD","is_pinned":false},{"caption":"פיליבסטרים ארוכים, לילות לבנים במסדרונות הכנסת, ומאבק בלתי מתפשר על דמותה החברתית של המדינה - ככה נראתה השותפות שלי ושל חברתי ח”כ נעמה לזימי בכנסת ה-24. \nכשנעמה ואני עבדנו יחד, האינטרס הציבורי תמיד היה במרכז: נלחמנו על זכויות עובדים, על חינוך ציבורי ממלכתי חזק, על הגנה על נוער בסיכון ועל הזרמת תקציבי בריאות ותשתיות לפריפריה. שנה אחת של עבודה טובה רק פתחה לנו את התיאבון. יש לנו עוד כברת דרך ארוכה לעשות יחד לטובת הציבור בישראל, כחלק מתוך שותפות יהודית ערבית מנצחת.\n נעמה, השותפות איתך היא כבוד גדול, ובכנסת הבאה אני מקווה בגאווה להיות הסגן שלך כשתהיי שרת החינוך!","datetime":"2026-07-02T15:58:25.000Z","id":"3932477462854919042","image_url":"https://scontent-dfw6-2.cdninstagram.com/v/t51.82787-15/736163470_18113504176788249_6631017263262051846_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gFntpc1qmOBRMONlLWQtB9C4kQvqdcBBY8FTjAICzlY2XDtdyOnLkiyi3bovHaWKJA&_nc_ohc=-1q9KtSMh84Q7kNvwFIFxcQ&_nc_gid=JteQxclmJ0qADs0nPG7kSw&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQBiNH2euIbK6lsb1k4PTgAUVs8_zfFCn2NeGmWopo2dyQ&oe=6A5913F9&_nc_sid=8b3546","likes":20,"content_type":"Video","url":"https://www.instagram.com/p/DaS92rUsmOC","video_url":"https://scontent-dfw6-1.cdninstagram.com/o1/v/t2/f2/m86/AQOURq5Xn_qmw1dtSoLJl7kglFKshmzy8sJ2N5ipBPrwJ9IZ4T0Bit2Y5s4mI35Ki2JZROUmW2mtYEWNoLvMdaWVxDYVgShoVzM_KkU.mp4?_nc_cat=101&_nc_sid=5e9851&_nc_ht=scontent-dfw6-1.cdninstagram.com&_nc_ohc=-lyP48q4IxQQ7kNvwEx5ZSd&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MjIxNTI2MTE1OTMxNDc3OSwiYXNzZXRfYWdlX2RheXMiOjksInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjo4OCwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=e83d5d318e644d13&_nc_&_nc_gid=JteQxclmJ0qADs0nPG7kSw&_nc_ss=7a22e&_nc_zt=28&oh=00_AQAeCwysQHhr2FK8K_DdspSqqlyynLPft6kGpynvKBOl_A&oe=6A55308E","is_pinned":false},{"caption":"1,000 ימים חלפו מאז טבח ה7 באוקטובר.\n\n1,000 ימים מאז האסון הגדול ביותר שידעה מדינת ישראל. 1,000 ימים של כאב, של אובדן, של משפחות שכולות, של קהילות שנחרבו ושל אלפי חיים שנגדעו. \n\n*הרוע לא הבדיל בין דם לדם. כולנו נפגענו: יהודים וערבים, דרוזים ובדואים*.\n\n גם אחרי 1,000 ימים, הממשלה עדיין מסרבת לקחת אחריות וראש הממשלה ממש עושה גזלייט לקורבנות כשהוא לועג לכולם.\n\nבסיוטים הכי גדולים שלנו לא האמנו שדבר כזה יכול לקרות ושלא תוקם ועדת חקירה. \nנדרשת ועדת חקירה ממלכתית שתחשוף את הכשלים ותבטיח שלעולם לא נחזור עליהם. אנחנו נחליף את הממשלה הרעה הזו, ממשלת הטבח בממשלת אחריות. \nאנחנו נעצור את ההסתה נגדנו ונגד כל מי שדורש תשובות. נעצור את הסחות הדעת והניסיונות לטשטש את האמת.\n\nלמען המשפחות השכולות, למען שורדי הטבח, למען פדויי השבי, למען הלוחמים, נכי צה”ל, הלומי הקרב ולמען כל אזרחי ואזרחיות ישראל- האמת חייבת להיחשף.\n\nכאשר נחליף את הממשלה הרעה הזו ונחזיר לישראל הנהגה אחראית, אחד הצעדים הראשונים שאעשה יהיה להתחייב ולפעול להקמת ועדת חקירה ממלכתית, עצמאית ובלתי תלויה, שתבדוק ללא מורא וללא משוא פנים את כל הדרגים ואת כל הכשלים שהובילו ל7 באוקטובר.\n\nזו חובתנו כלפי מי שאיבדנו, כלפי מי שנפגעו, וכלפי הדורות הבאים.\n\nאסור שהאמת תישאר קבורה ואסור שהאחריות תישאר יתומה.","datetime":"2026-07-02T07:11:04.000Z","id":"3932212368068004254","image_url":"https://scontent-dfw6-2.cdninstagram.com/v/t51.82787-15/731761169_18113426233788249_2159471874815757863_n.jpg?stp=dst-jpg_e15_tt6&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gFntpc1qmOBRMONlLWQtB9C4kQvqdcBBY8FTjAICzlY2XDtdyOnLkiyi3bovHaWKJA&_nc_ohc=AerdJTwn6msQ7kNvwHO6QMS&_nc_gid=JteQxclmJ0qADs0nPG7kSw&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQCBA8WWUPkmyPzgO9LXbeIbD8fdZQmi-kZobmHOVDErew&oe=6A591031&_nc_sid=8b3546","likes":9,"content_type":"Carousel","url":"https://www.instagram.com/p/DaSBlCkF0me","is_pinned":false},{"caption":"שנת הלימודים שמסתיימת היום לא הייתה שנה רגילה.\n\nזו הייתה שנה שבה ילדות וילדים, תלמידות ותלמידים, לצד צוותי החינוך, נאלצו להתמודד עם מלחמה, אזעקות, חוסר ודאות ושגרת חירום.\n\nאני מבקש לברך את כל ילדי ישראל על סיום השנה, ולהודות לצוותי החינוך- המורות והמורים, הגננות והגננים, המנהלות והמנהלים וכל נשות ואנשי החינוך שהיו עבור התלמידים עוגן של יציבות, ביטחון ותקווה גם בשנה הקשה שעברו. \n\nכמי שהקדיש את חייו לחינוך, אני יודע שבית ספר הוא הרבה יותר ממקום של לימודים. הוא מקום שמעניק שייכות, ערכים וחוסן ונמצא כעוגן לילדים במיוחד בתקופות קשות.\n\nאני מאחל לכל ילדות וילדי ישראל חופשת קיץ שקטה, בטוחה ומהנה. מגיע לכולנו לקוות שהשנה הבאה תיפתח במציאות טובה יותר, עם פחות פחד ויותר תקווה, עם יותר ביטחון ויותר עתיד.\n\nשמרו על עצמכם ושתהיה חופשה נעימה!","datetime":"2026-06-30T19:14:44.000Z","id":"3931126996338379837","image_url":"https://scontent-dfw6-2.cdninstagram.com/v/t51.82787-15/731022958_18113132734788249_46709578154463678_n.jpg?stp=dst-jpg_e15_tt6&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gFntpc1qmOBRMONlLWQtB9C4kQvqdcBBY8FTjAICzlY2XDtdyOnLkiyi3bovHaWKJA&_nc_ohc=lKI4nm6Qs5cQ7kNvwGRJy2T&_nc_gid=JteQxclmJ0qADs0nPG7kSw&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQAO9nAFgpbFy3G7xpmPlJRjUyte9rMOlqZxmuy0SELcDg&oe=6A591DE7&_nc_sid=8b3546","likes":10,"content_type":"Image","url":"https://www.instagram.com/p/DaOKyzXsow9","is_pinned":false}],"profile_image_link":"https://scontent-dfw6-2.cdninstagram.com/v/t51.82787-19/726850211_18109774252788249_7173900902191084975_n.jpg?stp=dst-jpg_s320x320_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gFntpc1qmOBRMONlLWQtB9C4kQvqdcBBY8FTjAICzlY2XDtdyOnLkiyi3bovHaWKJA&_nc_ohc=WJSyESadpBcQ7kNvwEHXhm9&_nc_gid=JteQxclmJ0qADs0nPG7kSw&edm=AOQ1c0wBAAAA&ccb=7-5&oh=00_AQDP6RLVNLjPnJDHSdDbBC_DM9sJu_cLTO8WfUiTM1aF-Q&oe=6A59325A&_nc_sid=8b3546","profile_url":"https://instagram.com/alidemocrats","profile_name":"Ali Salalha","highlights_count":0,"full_name":"Ali Salalha","is_private":false,"url":"https://www.instagram.com/alidemocrats/","is_joined_recently":false,"has_channel":false,"partner_id":"23703484248","related_accounts":[],"external_url_title":{"url":"https://did.li/alidemocrats","title":"חכ״ל עלי סלאלחה"},"timestamp":"2026-07-12T08:20:44.052Z","input":{"url":"https://www.instagram.com/alidemocrats/"}}]