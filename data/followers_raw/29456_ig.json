&edm=AOQ1c0wAAAAA&ccb=7-5&oh=00_AQAPrOPReDWKZ4ca9Q4Wa6LikN8xAiSf0pqdZQFkqC62ng&oe=6A591BA8&_nc_sid=8b3546","likes":79,"content_type":"Image","url":"https://www.instagram.com/p/DaagUBqjgEr","is_pinned":false},{"caption":"במשך הרבה שנים הכרתי את Elah Alkalay מרחוק. כל מי שפועלת בזירה כלשהי לקידום נשים ושוויון הכירה אותה -  יו״ר שדולת הנשים.\n\nואז הגיעה המחאה, ובמחאה לטייטלים אין משמעות, רק לעשייה. ונעמדנו בשורה אחת, של העושות והעושים. \nואז הקמנו את תנועת עוגן לעתיד, וגם לשם אלה הלכה איתנו.\n \nורק אז גיליתי שאבא שלה וסבתא שלי היו ביחד בהכשרה במשגב עם 🥹, ושבעצם אנחנו מכירות כל החיים. \n\nבסגירת המעגל הזאת אני גאה לקבל את התמיכה של אלה בזכות מה שעשיתי ועבור כל מה שעוד אעשה.","comments":2,"datetime":"2026-07-05T10:40:02.000Z","id":"3934491851277279886","image_url":"https://scontent-dfw6-2.cdninstagram.com/v/t15.5256-10/740303681_1616710750057593_6101569099341021806_n.jpg?stp=dst-jpg_e15_fr_p1080x1080_tt6&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gF0LfCUkrB5FrtCKdk6S9Q7-ytyUmrd3sVV0ALzTWWfcPCmHAKi75Nxta1G-3EPEJ4&_nc_ohc=ZJvDtG-yhesQ7kNvwFgkZgO&_nc_gid=jYdzcAE9jVrQId2Sei_FRw&edm=AOQ1c0wAAAAA&ccb=7-5&oh=00_AQDHKNCeVzKLbCR2CvJgNwKdfwHF_68CcmVBqAtRFDPzjA&oe=6A593414&_nc_sid=8b3546","likes":10,"content_type":"Video","url":"https://www.instagram.com/p/DaaH34vDSKO","video_url":"https://scontent-dfw5-1.cdninstagram.com/o1/v/t2/f2/m366/AQO0xSzuqLJyY8Ut1iUEmOvLTFdtIdPkrUAluh3qLW5qlHXhimXVf-s1xGm1w50v9WAiVuKRVY93SKejgB6qQBcxSkldm2AK890hdtKuzRWHhQ.mp4?_nc_cat=111&_nc_sid=5e9851&_nc_ht=scontent-dfw5-1.cdninstagram.com&_nc_ohc=NOYcE05z9LcQ7kNvwFLLs62&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNzIwLmRhc2hfaDI2NC1iYXNpYy1nZW4yXzcyMHAiLCJ4cHZfYXNzZXRfaWQiOjEwMDc1OTY1OTg2MzgyMzYsImFzc2V0X2FnZV9kYXlzIjo2LCJ2aV91c2VjYXNlX2lkIjoxMDEyMywiZHVyYXRpb25fcyI6NzgsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ%3D%3D&ccb=17-1&vs=fb8496267efa8747&_nc_-B2WWngEA&_nc_gid=jYdzcAE9jVrQId2Sei_FRw&_nc_ss=7a22e&_nc_zt=28&oh=00_AQCsZQk8a_WN9wLrmcRfhwwmJj-BAA9LOu3q1DWS06KnXw&oe=6A591AD9","is_pinned":false},{"caption":"⁨\tעופר בן 8.5 אבל נראה הרבה יותר גדול.\nהוא סיפר שהוא בכיתה ב׳, אבל רק כי שכח שכבר חופש גדול והסתיימה השנה.\nהוא אופטימי, אבל צריך רגע הסבר מה זה בדיוק.\n\nבצומת הגומא המחאה הפכה להפגנה, ההפגנה הופכת לקהילה, המטרה הופכת לתקווה והתקווה תוביל לניצחון. \n\nהלוואי שבכל הארץ יעתיקו את מה שמיכל ועטר ואנשי הצפון עושים בצומת הגומא. \nהלוואי שבכל הצמתים תהיה מוסיקה של שינוי, קלפי של אופטימיות וילדים שבאים כי הם רוצים להיות חלק מהרוחות של התקווה. \n\nא.נשי המחנה הליברלי באשר אתם ואתן: תצטרפו לצומת, כי עם שפוי עושה שינוי.⁩","comments":1,"datetime":"2026-07-04T19:28:56.000Z","id":"3934033293071491407","image_url":"https://scontent-dfw5-1.cdninstagram.com/v/t39.30808-6/736857936_10164391434953381_7131422764899418234_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-dfw5-1.cdninstagram.com&_nc_cat=105&_nc_oc=Q6cZ2gF0LfCUkrB5FrtCKdk6S9Q7-ytyUmrd3sVV0ALzTWWfcPCmHAKi75Nxta1G-3EPEJ4&_nc_ohc=i2EiOosIcqwQ7kNvwFmxlhZ&_nc_gid=jYdzcAE9jVrQId2Sei_FRw&edm=AOQ1c0wAAAAA&ccb=7-5&oh=00_AQAW2sfM3YMYuncdrA8op6MaqxudD-aVuV1PabNOehOjyQ&oe=6A59085C&_nc_sid=8b3546","likes":13,"content_type":"Image","url":"https://www.instagram.com/p/DaYfm_IFiFP","is_pinned":false},{"caption":"התפרסמה היום כתבה על הפעילות של העמותה שהקמתי עם Moshe Radman Abutbul ומנכ״לתי עד שהחלטתי לצאת לדרך חדשה. \n\nכשהבנתי שהדמוקרטיה שלנו לא תינצל רק מהפגנות בין שבתות, החלטתי להתפטר ממיקרוסופט וללכת להוביל את המחאה ולהקים תשתיות למחנה הליברלי, כי רק ככה בונים מסלול חדש למחנה. \n\nבמשך כמעט שלוש שנים עבדתי אינספור שעות בכל יום, שבוע וחודש. הקמנו בית תוכן שעושה תוכן מסביב לשעון, נגענו בכל תחום חשוב, הקמנו עשרות פודקאסטים, יצרתי וערכתי סדרות דוקו איכותיות ומעמיקות, הרמנו עמודי תוכן בכל הרשתות החברתיות, ליווינו והצמחנו יוצרי תוכן, הייתי שותפה בהקמת קרן מענקים לעידוד יצירה ליברלית ברשתות, יצרנו שיתופי פעולה עם המוני גופים של המחנה, יצרנו את ערוץ החדשות חדר מלחמה, הקמנו את תנועת עוגן לעתיד שמייצרת תכנים, סדנאות, ספרים, הרצאות ולא מפסיקה להמציא ולחדש. ובטח שכחתי כמה דברים. \n\nבמקביל לזה הובלנו גם אירועי מחאה גדולים, במות, ימי מצור, צעדות - מה לא. \nוהתנהלנו בשיא השקיפות והחמרנו עם עצמנו תמיד, כדי להיות בדיוק השינוי שאנחנו מצפים לראות. \n\nכשהחלטתי שאני רוצה לבנות את המסלול שלי לפוליטיקה, התפטרתי מתפקידי כמנכ״לית ומנהלת התוכן של העמותה (כבר באפריל 25). את מקומי תפסו Tali Wexler ו Michal Hadas Rubin - שתי נשים מוכשרות וחרוצות, וחברות. הן ממשיכות להוביל את עוגן אל עתיד טוב יותר - מפתחות, מקדמות, יוזמות ומסבות לי גאווה גדולה בכל פעם שאני מסתכלת על מה שבניתי ומה שזה גדל להיות.\n\nאני יודעת שבמקור ניסו למצוא קצת ג׳וס, אבל בשלושים השנים שאני בעשייה חברתית כבר למדתי שכשאת עושה המון דברים טובים במקביל ובקצב בלתי אפשרי, אנשים לפעמים מרימים גבה. ככה למדתי גם שאור היום עושה רק טוב למי שעושה טוב. \n\nלשוחרי דמוקרטיה כמונו תמיד טוב שיש מי ששואלת ומי שמבקר, וטוב לענות על שאלות, וטוב להמשיך לעשות ולבנות עוד ועוד. \n\n**ותודה ענקית לעשרות השותפים והשותפות, העובדות והמתנדבים, ששום דבר מכל אלה לא היינו יכולים לעשות בלעדיהם.","comments":1,"datetime":"2026-07-03T11:27:43.000Z","id":"3933066310150148700","image_url":"https://scontent-dfw6-1.cdninstagram.com/v/t39.30808-6/738745423_10164385489063381_6207576716653389078_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_ht=scontent-dfw6-1.cdninstagram.com&_nc_cat=101&_nc_oc=Q6cZ2gF0LfCUkrB5FrtCKdk6S9Q7-ytyUmrd3sVV0ALzTWWfcPCmHAKi75Nxta1G-3EPEJ4&_nc_ohc=4S_4sVGByGsQ7kNvwG4SMW4&_nc_gid=jYdzcAE9jVrQId2Sei_FRw&edm=AOQ1c0wAAAAA&ccb=7-5&oh=00_AQBj3kdp_V19_ObjwBE6PJzC9TIiaJrhi9FpcLJVAI9jbg&oe=6A590B34&_nc_sid=8b3546","likes":14,"content_type":"Image","url":"https://www.instagram.com/p/DaVDviGjlJc","is_pinned":false}],"profile_image_link":"https://scontent-dfw6-2.cdninstagram.com/v/t51.82787-19/569431168_18537990820036377_6882199441974276496_n.jpg?stp=dst-jpg_s320x320_tt6&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLmRqYW5nby4xMDgwLmMyIn0&_nc_ht=scontent-dfw6-2.cdninstagram.com&_nc_cat=109&_nc_oc=Q6cZ2gF0LfCUkrB5FrtCKdk6S9Q7-ytyUmrd3sVV0ALzTWWfcPCmHAKi75Nxta1G-3EPEJ4&_nc_ohc=ZN1SEXjPWTkQ7kNvwEWzRbA&_nc_gid=jYdzcAE9jVrQId2Sei_FRw&edm